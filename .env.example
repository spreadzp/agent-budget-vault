# Frontend (Vite) — BudgetVaultFactory address on the target network
VITE_FACTORY_ADDRESS=
# Target chain: 5042002 testnet (default) / 5042 mainnet
VITE_CHAIN_ID=5042002

# Optional RPC overrides (official rpc.*.arc.io is geo-blocked in some regions)
# VITE_ARC_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
# VITE_ARC_TESTNET_RPC_URL=https://rpc.blockdaemon.testnet.arc.io

# Deploy scripts (self-deploy.ts / forge script)
DEPLOYER_PRIVATE_KEY=
USDC_TOKEN_ADDRESS=          # Arc Testnet/Mainnet USDC: 0x3600000000000000000000000000000000000000

# Optional RPC proxy (compass-deploy.ts)
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
